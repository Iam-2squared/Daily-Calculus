# Local development uses SQLite unless all three cloud settings below are set.
# On Vercel these cloud settings are required; local disk is never used.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
CALCULUS_STORE_KEY=

# Local SQLite database (not used in cloud mode).
DATABASE_PATH=data/daily-calculus.sqlite
PORT=3001
# Optional: true for HTTPS; false for a local HTTP production smoke test.
# Production defaults to true; local dev defaults to false.
# COOKIE_SECURE=true
# Set only behind a trusted single reverse proxy; Vercel IPs handled automatically.
TRUST_PROXY=0
