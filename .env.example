# Local development uses SQLite unless all three cloud settings below are set.
# On Vercel these cloud settings are required; local disk is never used.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
CALCULUS_STORE_KEY=

# Local SQLite database (not used in cloud mode).
DATABASE_PATH=data/daily-calculus.sqlite
PORT=3001
# Optional: true for HTTPS; false for a local HTTP production smoke test.
# Production defaults to true; local dev defaults to false.
# COOKIE_SECURE=true
# Set only behind a trusted single reverse proxy; Vercel IPs handled automatically.
TRUST_PROXY=0

# Optional KGS wallet link, server only. Use two DIFFERENT new random secrets.
# A is shared with KGS; B is shared with Target. Never use a VITE_ prefix.
CALCULUS_KGS_INTEGRATION_SECRET=
CALCULUS_TARGET_INTEGRATION_SECRET=
CALCULUS_KGS_IDENTITY_URL=https://kgs01-git-codex-kgs01-shared-release-iam-2squareds-projects.vercel.app
CALCULUS_TARGET_URL=https://kgs-target.vercel.app
